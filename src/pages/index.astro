---
import Layout from '../layouts/Layout.astro';

const WHATSAPP_NUMBER = "54911XXXXXXXX"; 
const WHATSAPP_LINK = `https://wa.me/${WHATSAPP_NUMBER}?text=Hola%20Clarisa!%20Vi%20tu%20web%20y%20me%20gustar%C3%ADa%20consultarte%20por%20tus%20servicios.`;

const services = [
    {
        title: "Planificación Fiscal",
        description: "Alcanzá la estructura fiscal óptima. Evaluación del cliente para determinar una estrategia fiscal que cumpla con la normativa de ARCA, de ingresos brutos y otros tributos, según el modelo de su emprendimiento o negocio.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>`,
        details: ["Inscripciones AFIP/ARBA", "Recategorizaciones", "Liquidación mensual"]
    },
    {
        title: "Consultoría Financiera",
        description: "Hace trabajar tus ahorros. Análisis de perfil de inversor y flujos de fondos. Recomendaciones para optimizar tus ganancias, enfrentarte a pérdidas y transformar tus ahorros en inversiones.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>`,
        details: ["Control de gastos", "Planificación de ahorro", "Educación financiera"]
    },
    {
        title: "Certificaciones e Informes",
        description: "Opinión profesional que te ayuda a cumplir. Solicitar préstamos o comprar bienes muchas veces requiere una certificación profesional basada en tu información patrimonial o de ingresos.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4"/><path d="M5 21V10.85"/><path d="M19 21V10.85"/><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/></svg>`,
        details: ["Balances y Auditorías", "Certificaciones contables", "Gestión de Tesorería"]
    }
];

const faqs = [
    {
        q: "¿Cómo es la modalidad de trabajo?",
        a: "Trabajamos de forma 100% digital. Iniciamos con una consulta via WhatsApp o videollamada para diagnosticar tu situación y luego gestionamos todo de manera remota con reportes periódicos."
    },
    {
        q: "¿Realizás certificaciones de ingresos?",
        a: "Sí, como Contadora Pública matriculada emito certificaciones de ingresos para bancos, alquileres o trámites oficiales, con la firma certificada ante el Consejo Profesional correspondiente."
    },
    {
        q: "¿Hacés planeamiento para nuevas inversiones?",
        a: "Exactamente. Analizamos tu capacidad de ahorro real y te ayudo a entender las mejores opciones del mercado (CEDEARs, MEP, Fondos) para proteger tu capital contra la inflación."
    },
    {
        q: "¿Atendés a clientes de todo el país?",
        a: "Sí. Gracias a la digitalización de los sistemas de AFIP y organismos provinciales, puedo llevar la contabilidad de clientes en cualquier punto de Argentina."
    },
    {
        q: "¿Qué documentación necesito para empezar?",
        a: "Para la primera asesoría solo tus dudas. Si es para gestión impositiva, necesitaremos tu CUIT y Clave Fiscal (que manejamos con total confidencialidad y ética profesional)."
    },
    {
        q: "¿Cuál es el costo de los servicios?",
        a: "Los honorarios se ajustan a la complejidad de cada caso. Ofrezco abonos mensuales para gestión continua o presupuestos por trámites puntuales."
    }
];
---

<Layout 
    title="Clarisa Reyes | Contabilidad Estratégica & Finanzas"
    description="De la Tesorería Pública a tu economía personal. Clarisa Reyes te brinda la seguridad técnica que tus finanzas necesitan."
>
    <nav class="fixed w-full z-50 bg-brand-cream/95 backdrop-blur-md border-b border-brand-sand">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="font-display font-bold text-2xl tracking-tight text-brand-olive">
                clarisareyes<span class="text-brand-gold">.finanzas</span>
            </div>
            <div class="hidden md:flex gap-8 items-center font-sans font-medium text-brand-olive/80">
                <a href="#servicios" class="hover:text-brand-gold transition-colors">Servicios</a>
                <a href="#sobre-mi" class="hover:text-brand-gold transition-colors">Sobre mí</a>
                <a href="#faq" class="hover:text-brand-gold transition-colors">Consultas</a>
                <a href={WHATSAPP_LINK} class="bg-brand-olive text-brand-cream px-6 py-2.5 rounded-full hover:bg-brand-gold transition-all shadow-lg shadow-brand-olive/20 font-sans">
                    Agendar asesoría
                </a>
            </div>
        </div>
    </nav>

    <main>
        <section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 bg-brand-cream">
            <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h1 class="font-display text-5xl lg:text-7xl font-bold text-brand-olive leading-[1.1] mb-8">
					    Estrategia fiscal
					    y financiera para el
					    <span class="text-brand-gold italic">crecimiento personal y de tu empresa.</span>
					</h1>

					<div class="font-sans text-xl text-brand-olive/80 leading-relaxed mb-10 max-w-xl">
					    <p class="mb-4 font-semibold">
					        Trabajo con profesionales y emprendedores que buscan:
					    </p>
					    <ul class="space-y-4">
					        <li class="flex items-start">
					            <span class="text-brand-gold mr-3 mt-1.5 text-sm">●</span>
					            <span>Entender realmente cuánto ganan, ordenar sus finanzas y <strong>planificar sus impuestos.</strong></span>
					        </li>
					        <li class="flex items-start">
					            <span class="text-brand-gold mr-3 mt-1.5 text-sm">●</span>
					            <span>Tomar <strong>decisiones financieras inteligentes</strong>, adecuadas a su perfil y crecimiento futuro.</span>
					        </li>
					    </ul>
					</div>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href={WHATSAPP_LINK} class="flex items-center justify-center px-8 py-4 bg-brand-gold text-white rounded-2xl font-sans font-bold text-lg hover:bg-brand-olive transition-all shadow-xl shadow-brand-gold/20 hover:shadow-brand-olive/20 overflow-hidden">
                            Agendar asesoría 
                            <svg 
                                xmlns="http://www.w3.org/2000/svg" 
                                class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" 
                                fill="none" 
                                viewBox="0 0 24 24" 
                                stroke="currentColor" 
                                stroke-width="3"
                            >
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </a>
                        <a href="#servicios" class="flex items-center justify-center px-8 py-4 bg-white border-2 border-brand-sand text-brand-gold rounded-2xl font-sans font-bold text-lg hover:border-brand-gold transition-all">
                            Ver servicios
                        </a>
                    </div>
                </div>
                <div class="relative">
                    <div class="aspect-[4/5] rounded-[2rem] overflow-hidden shadow-2xl border-[12px] border-white bg-brand-sand">
                        <img 
                            src="/images/clarisa.jpeg"
                            alt="Clarisa Reyes Profesional" 
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <div class="absolute -bottom-6 -left-6 bg-white p-6 rounded-2xl shadow-xl">
                        <div class="flex items-center gap-4">
                            <div class="bg-brand-cream p-3 rounded-xl text-brand-gold text-2xl font-display font-bold">10+</div>
                            <div class="font-sans text-sm font-bold text-brand-olive leading-tight">Años de <br/>Experiencia</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="servicios" class="py-24 bg-white">
            <div class="max-w-7xl mx-auto px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-20">
                    <h2 class="text-4xl font-bold text-brand-olive mb-6 font-display">Asesoría Integral</h2>
                    <p class="font-sans text-lg text-brand-olive/80">Soluciones técnicas diseñadas para el contexto económico actual. Orden, transparencia y ahorro fiscal.</p>
                </div>
                <div class="grid md:grid-cols-3 gap-8">
                    {services.map(s => (
                        <div class="p-8 rounded-3xl border border-brand-sand bg-brand-cream hover:bg-white hover:border-brand-gold hover:shadow-2xl hover:shadow-brand-gold/10 transition-all duration-500 group">
                            <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-brand-gold shadow-sm mb-6 group-hover:bg-brand-gold group-hover:text-white transition-all duration-300" set:html={s.icon} />
                            <h3 class="font-display text-2xl font-bold text-brand-olive mb-4">{s.title}</h3>
                            <p class="font-sans text-brand-olive/80 mb-8 leading-relaxed">{s.description}</p>
                            <ul class="space-y-3">
                                {s.details.map(d => (
                                    <li class="flex items-center text-sm font-sans font-medium text-brand-olive/70">
                                        <svg class="w-4 h-4 mr-2 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg>
                                        {d}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section id="sobre-mi" class="py-24 bg-white">
            <div class="max-w-7xl mx-auto px-6 lg:px-8">
                <div class="lg:grid lg:grid-cols-2 gap-20 items-center">
                
                    <div class="space-y-8">
                        <div>
                            <h2 class="font-display text-4xl font-bold text-brand-olive leading-tight mb-6">
                                Solidez técnica en <br/>
                                <span class="text-brand-gold">gestión financiera.</span>
                            </h2>
                            <p class="font-sans text-lg text-brand-olive/80 leading-relaxed">
                                Soy Clarisa Reyes Lima, contadora pública con 12 años de experiencia en planificación fiscal e idónea en mercado de capitales desde el año 2025.

								Trabajo con profesionales y emprendedores que quieren algo más que “hacer los impuestos”: <strong>quieren entender su dinero, optimizarlo y hacerlo crecer.</strong>
															
								Mi enfoque combina análisis técnico, mirada estratégica y acompañamiento cercano.
															
								Porque cuando entendés tus números, tomás decisiones con seguridad.
                            </p>
                        </div>
                    
                        <div class="space-y-4">
					    <div class="flex items-center gap-5 p-6 bg-brand-cream rounded-2xl border-l-4 border-brand-olive shadow-sm transition-all hover:bg-brand-sand/20">
					        <div class="text-brand-olive shrink-0">
					            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
					                <path d="M6 12v5c3 3 9 3 12 0v-5"/>
					            </svg>
					        </div>
					        <div>
					            <h4 class="font-sans font-bold text-brand-olive text-lg">Contadora Pública UNLP</h4>
					            <p class="font-sans text-brand-olive/70 text-sm leading-relaxed">
					                <span class="block">Matriculada en Provincia de Buenos Aires <span class="italic text-brand-gold font-medium">Tº169 Fº109</span></span>
					                <span class="block">Matriculada en Ciudad Autónoma de Buenos Aires <span class="italic text-brand-gold font-medium">Tº444 Fº128</span></span>
					            </p>
					        </div>
					    </div>
					
					    </div>
                    </div>
                
                    <div class="relative mt-12 lg:mt-0 px-4 sm:px-12">
                        <div class="absolute inset-0 bg-brand-sand rounded-full blur-3xl opacity-30 transform -translate-y-10"></div>
                        <div class="relative">
                            <div class="rounded-[2rem] overflow-hidden border-8 border-white shadow-2xl shadow-brand-sand/50">
                                <img 
                                    src="/images/clarisa.jpeg"
                                    alt="Clarisa Reyes Profesional" 
                                    class="w-full h-[550px] object-cover grayscale-[20%] hover:grayscale-0 transition-all duration-700"
                                />
                            </div>
                        </div>
                    </div>
                
                </div>
            </div>
        </section>

        <section id="faq" class="py-24 bg-brand-cream">
            <div class="max-w-3xl mx-auto px-6">
                <div class="text-center mb-12">
                    <h2 class="font-display text-4xl font-bold text-brand-olive mb-4">Centro de Consultas</h2>
                    <p class="font-sans text-brand-olive/70 font-medium">Seleccioná tu duda para obtener una respuesta inmediata</p>
                </div>
            
                <div class="bg-white border border-brand-sand rounded-[2rem] p-8 shadow-xl shadow-brand-sand/20">
                    <div class="space-y-6">
                        <div class="relative">
                            <label for="faq-select" class="block font-sans text-sm font-bold text-brand-gold uppercase tracking-widest mb-3 ml-1">
                                ¿En qué puedo ayudarte?
                            </label>
                            <select 
                                id="faq-select" 
                                class="w-full bg-brand-cream border-2 border-brand-sand text-brand-olive text-lg font-sans font-bold rounded-2xl p-5 outline-none focus:border-brand-gold focus:ring-4 focus:ring-brand-gold/10 transition-all appearance-none cursor-pointer"
                            >
                                {faqs.map((item, index) => (
                                    <option value={index}>{item.q}</option>
                                ))}
                            </select>
                            <div class="absolute right-5 bottom-5 pointer-events-none text-brand-gold">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                </svg>
                            </div>
                        </div>
                    
                        <div class="bg-brand-cream/50 rounded-2xl p-8 border border-brand-sand/50 min-h-[150px] flex items-center">
                            <p id="faq-answer" class="font-sans text-brand-olive text-lg leading-relaxed font-medium animate-fadeIn">
                                {faqs[0].a}
                            </p>
                        </div>
                    
                        <div class="pt-4 flex justify-center">
                            <a href={WHATSAPP_LINK} class="font-sans text-sm font-bold text-brand-gold hover:text-brand-olive flex items-center gap-2 transition-colors">
                                ¿Tu duda no está aquí? Consultame por WhatsApp
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <script define:vars={{ faqs }}>
            const select = document.getElementById('faq-select');
            const answerDisplay = document.getElementById('faq-answer');
        
            select.addEventListener('change', (e) => {
                const index = e.target.value;
            
                answerDisplay.style.opacity = '0';
            
                setTimeout(() => {
                    answerDisplay.textContent = faqs[index].a;
                    answerDisplay.style.opacity = '1';
                }, 150);
            });
        </script>

        <style>
            #faq-answer {
                transition: opacity 0.2s ease-in-out;
            }
            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(5px); }
                to { opacity: 1; transform: translateY(0); }
            }
            .animate-fadeIn {
                animation: fadeIn 0.4s ease-out;
            }
        </style>
    </main>

    <footer class="bg-brand-olive text-brand-cream pt-20 pb-10">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 grid md:grid-cols-2 gap-12 border-b border-brand-sand/20 pb-12 mb-10">
            <div>
                <div class="font-display text-2xl font-bold mb-6 italic">clarisareyes<span class="text-brand-gold">.finanzas</span></div>
                <p class="font-sans text-brand-cream/70 max-w-sm">Acompañando tu crecimiento con solidez técnica y compromiso profesional.</p>
            </div>
            <div class="flex flex-col md:items-end gap-6">
                <div class="font-sans text-lg font-bold">Contacto Directo</div>
                <a href={WHATSAPP_LINK} class="text-brand-gold text-2xl font-sans font-medium hover:text-white transition-colors tracking-tight">
                    +54 9 11 XXXX-XXXX
                </a>
                <div class="font-sans text-brand-cream/50 text-sm">Buenos Aires, Argentina | Atención Remota</div>
            </div>
        </div>
        <div class="text-center font-sans text-brand-cream/40 text-xs tracking-widest font-medium">
            © 2026 Clarisa Reyes Lima. Todos los derechos reservados.
        </div>
    </footer>

    <a href={WHATSAPP_LINK} target="_blank" class="fixed bottom-8 right-8 bg-[#25D366] text-white p-5 rounded-full shadow-2xl hover:scale-110 active:scale-95 transition-all z-50 animate-bounce">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.06 3.973L0 16l4.204-1.102a7.934 7.934 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
        </svg>
    </a>
</Layout>